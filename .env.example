# ==============================================================================
# SellerFlow AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your target environment.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Backend API Configuration
PORT=8000
DATABASE_URL=postgresql://sellerflow_user:your_password@localhost:5432/sellerflow
# Or for local SQLite testing:
# DATABASE_URL=sqlite:///./sellerflow.db

# Authentication & Security
JWT_SECRET_KEY=generate-a-strong-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & File Uploads
STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
